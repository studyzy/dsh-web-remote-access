{
  "name": "@studyzy/dsh-web-remote-access",
  "description": "Out-of-tree dsh web-profile bundle: enables --host 0.0.0.0 and gates the Web UI behind a --web_token access token (cookie after first ?web_token= open). Forks @deepseek-ai/dsh-host-webserver and @deepseek-ai/dsh-web-app/startup.",
  "version": "1.0.0",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "harness",
    "plugin",
    "bundle",
    "web",
    "remote-access",
    "web-token",
    "authentication"
  ],
  "license": "MIT",
  "author": {
    "name": "studyzy",
    "email": "studyzy@163.com",
    "url": "https://github.com/studyzy"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/studyzy/dsh-web-remote-access.git"
  },
  "homepage": "https://github.com/studyzy/dsh-web-remote-access#readme",
  "bugs": {
    "url": "https://github.com/studyzy/dsh-web-remote-access/issues"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./webserver": {
      "types": "./lib/webserver.d.ts",
      "default": "./lib/webserver.js"
    },
    "./url": {
      "types": "./lib/url.d.ts",
      "default": "./lib/url.js"
    },
    "./polyfill": {
      "types": "./lib/polyfill.d.ts",
      "default": "./lib/polyfill.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/dsh-cmdline": "^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
